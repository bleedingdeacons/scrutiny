<?xml version="1.0" encoding="UTF-8"?>
<!--
    Schema is 10.5. Coverage include/exclude therefore lives in <source>,
    not the 9.x <coverage> element, which now carries only report options.

    This suite ran on PHPUnit 9.6 until wp_mock was dropped, not by choice:
    10up/wp_mock 1.1.1 declares "phpunit/phpunit": "^9.6" in its own require
    block and has no PHPUnit 10 branch, so asking for "^9.6|^10.0" alongside
    it always resolved to 9.6. Brain Monkey declares no PHPUnit constraint at
    all, which is what freed this.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.5/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         cacheDirectory=".phpunit.cache">
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
            <!--
                A test double, not a test case. Its name ends in "Test.php",
                so PHPUnit collects it and then reports that it does not
                extend TestCase.
            -->
            <exclude>tests/Unit/Cleanup/MemberPrunerForTest.php</exclude>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory suffix=".php">src</directory>
        </include>
        <exclude>
            <!--
                src/Admin is deliberately NOT excluded, and should not be
                re-added. It was, on the grounds that admin screens are
                render/callback glue only WordPress can exercise. Amber
                disproves that — it covers its whole src/Admin (7,815 lines) on
                this same tooling — and tests/Unit/Admin now covers Scrutiny's,
                including the render methods, driven inside an output buffer.

                Two things genuinely cannot run in-process, and neither is a
                reason to exclude the directory:

                  - handleSave() ends in wp_safe_redirect() followed by a bare
                    exit. The stubs record the redirect rather than throwing,
                    so exit runs and takes PHPUnit with it. The work behind
                    that guard lives in persistPostedSettings() and
                    savedRedirectUrl(), which are driven directly.
                  - The `if (!defined('ABSPATH')) exit;` header on every file,
                    which is never true under test.

                Those are the only uncovered lines in the directory: 443 of 446
                are hit. Removing this block moved the headline line coverage
                from 90.43% (1124/1243) to 92.16% (1564/1697) — it rose because
                the newly-counted lines are better covered than the existing
                average, which is not something to rely on in general. The
                denominator is the number to watch, not the percentage.
            -->

            <!--
                Interface files carry no executable behaviour beyond the
                `if (!defined('ABSPATH')) exit;` guard, so there is nothing to
                unit-test in them.
            -->
            <directory suffix=".php">src/Audit/Interfaces</directory>

            <!--
                Test doubles Scrutiny ships for the other plugins' suites. Test
                infrastructure that happens to live under src/ so it autoloads
                through the Scrutiny\ prefix in a consumer's test run — not
                production behaviour, so counting it would distort the
                denominator exactly as the interfaces above do.

                Its own behaviour is covered by tests/Unit/Testing, which still
                runs; it is only the coverage figure it stays out of.
            -->
            <directory suffix=".php">src/Testing</directory>
        </exclude>
    </source>
</phpunit>
