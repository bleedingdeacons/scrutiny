<?xml version="1.0" encoding="UTF-8"?>
<!--
    Schema is 10.5. Coverage include/exclude therefore lives in <source>,
    not the 9.x <coverage> element, which now carries only report options.

    This suite ran on PHPUnit 9.6 until wp_mock was dropped, not by choice:
    10up/wp_mock 1.1.1 declares "phpunit/phpunit": "^9.6" in its own require
    block and has no PHPUnit 10 branch, so asking for "^9.6|^10.0" alongside
    it always resolved to 9.6. Brain Monkey declares no PHPUnit constraint at
    all, which is what freed this.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.5/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         cacheDirectory=".phpunit.cache">
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
            <!--
                A test double, not a test case. Its name ends in "Test.php",
                so PHPUnit collects it and then reports that it does not
                extend TestCase.
            -->
            <exclude>tests/Unit/Cleanup/MemberPrunerForTest.php</exclude>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory suffix=".php">src</directory>
        </include>
        <exclude>
            <!--
                Admin screens are WordPress render/callback glue (list tables,
                settings fields, meta boxes, menu registration) exercised
                through WordPress at runtime rather than in unit tests, so they
                are excluded from the coverage denominator — the same call
                Reach and Integrity make for their own src/Admin.

                Load-bearing: dropping this block on the move from <coverage>
                to <source> would silently shift the Coveralls number.
            -->
            <directory suffix=".php">src/Admin</directory>
            <!--
                Interface files carry no executable behaviour beyond the
                `if (!defined('ABSPATH')) exit;` guard, so there is nothing to
                unit-test in them.
            -->
            <directory suffix=".php">src/Audit/Interfaces</directory>

            <!--
                Test doubles Scrutiny ships for the other plugins' suites. Test
                infrastructure that happens to live under src/ so it autoloads
                through the Scrutiny\ prefix in a consumer's test run — not
                production behaviour, so counting it would distort the
                denominator exactly as the interfaces above do.

                Its own behaviour is covered by tests/Unit/Testing, which still
                runs; it is only the coverage figure it stays out of.
            -->
            <directory suffix=".php">src/Testing</directory>
        </exclude>
    </source>
</phpunit>
